# ---- Azure OpenAI ----
# Leave AZURE_OPENAI_API_KEY empty to authenticate with Entra ID (az login / managed identity).
# Keyless needs the "Cognitive Services OpenAI User" role on the resource.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
# A small fast model just for question detection; falls back to the chat deployment.
AZURE_OPENAI_DETECT_DEPLOYMENT=gpt-4.1-nano
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Azure AI Speech (real-time transcription in the side panel) ----
# Leave AZURE_SPEECH_KEY empty to use Entra ID; then AZURE_SPEECH_RESOURCE_ID is required.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>

# ---- Server ----
PORT=3978
# Comma separated. Add your dev tunnel origin, e.g. https://abc123-5173.euw.devtunnels.ms
ALLOWED_ORIGINS=http://localhost:5173

# ---- Client (Vite) ----
# Leave empty: the client calls /api on its own origin and Vite proxies it to the
# server. That keeps it working through a single HTTPS tunnel inside Teams.
VITE_API_BASE=
