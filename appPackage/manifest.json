{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "5d6de114-2e0d-44db-8941-7090e69c681c",
  "packageName": "com.contoso.veritycue",
  "developer": {
    "name": "Contoso",
    "websiteUrl": "https://{{HOSTNAME}}",
    "privacyUrl": "https://{{HOSTNAME}}/privacy",
    "termsOfUseUrl": "https://{{HOSTNAME}}/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "VerityCue",
    "full": "VerityCue — private, grounded answer cues"
  },
  "description": {
    "short": "Detects customer questions live and suggests grounded answers.",
    "full": "VerityCue listens to the meeting conversation, detects questions asked by customers, and privately suggests concise, grounded answers with talking points and sources. Only you see the panel."
  },
  "accentColor": "#4F52B2",
  "configurableTabs": [
    {
      "configurationUrl": "https://{{HOSTNAME}}/config",
      "canUpdateConfiguration": false,
      "scopes": ["groupChat"],
      "context": ["meetingSidePanel", "meetingChatTab", "meetingDetailsTab"],
      "meetingSurfaces": ["sidePanel"]
    }
  ],
  "validDomains": ["{{HOSTNAME}}"],
  "devicePermissions": ["media"],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "OnlineMeetingTranscript.Read.Chat",
          "type": "Application"
        },
        {
          "name": "OnlineMeetingParticipant.Read.Chat",
          "type": "Application"
        }
      ]
    }
  }
}
